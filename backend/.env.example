# Backend environment template — placeholders only, never real secrets.
MONGODB_URI=mongodb://localhost:27017/climatehazard
MONGODB_DB=climatehazard
# Comma-separated exact origins, e.g. http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Open-Meteo archive host (do not change unless allowlist is updated in code)
WEATHER_PROVIDER_BASE_URL=https://archive-api.open-meteo.com
WEATHER_CONNECT_TIMEOUT_S=5
WEATHER_READ_TIMEOUT_S=15
WEATHER_MAX_RESPONSE_BYTES=2000000
# Rate limits (requests per 60s sliding window, per client IP)
RATE_LIMIT_ANALYSIS_PER_MIN=30
RATE_LIMIT_DEFAULT_PER_MIN=60
CACHE_TTL_SECONDS=86400
ALGORITHM_VERSION=v1
PROVIDER_DATASET_VERSION=open-meteo-archive-v1
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_REQUEST_BYTES=65536
